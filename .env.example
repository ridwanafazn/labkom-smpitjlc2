# Wajib. Ganti dengan string acak yang panjang.
FLASK_SECRET_KEY=ganti-dengan-string-acak-panjang

# Akun admin. Password dipakai saat startup untuk membuat/memperbarui hash admin.
ADMIN_NAME=Rahma Maulidina
ADMIN_PASSWORD=ganti-password-admin-yang-kuat

# Database produksi (Neon/Postgres). Kosongkan untuk memakai SQLite lokal.
DATABASE_URL=

# Telegram (opsional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Server
HOST=0.0.0.0
PORT=5000
THREADS=4
# Set 1 jika berjalan di belakang reverse proxy (Caddy/Nginx).
BEHIND_PROXY=0
# Set 1 hanya jika sudah memakai HTTPS.
COOKIE_SECURE=0
MAX_UPLOAD_MB=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900

# Backup
BACKUP_KEEP=10
# Folder salinan backup di disk/lokasi lain (opsional).
BACKUP_COPY_DIR=
# Isi untuk mengenkripsi ZIP backup dengan AES (butuh pyzipper).
BACKUP_PASSWORD=

# Path kustom (opsional)
# LABKOM_DB_PATH=
# LABKOM_UPLOAD_DIR=
# LABKOM_BACKUP_DIR=
# LABKOM_STUDENTS_PATH=
# LABKOM_LOG_DIR=
